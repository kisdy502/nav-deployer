# false：不连接 RMS；true：连接 RMS
RMS_ENABLED=true

# ===== 双机器人并行部署（B 套 = docker，A 套 = WSL 原生 + IDEA）=====
# 机器人 docker 栈在 D:\github\simulated_chassis（compose 项目名 simulated_chassis）
ROBOT_DOCKER_NETWORK=simulated_chassis_agv_network
# 容器网络内直连用内部监听端口 9090（机器人 compose：内部恒 9090，WEBSOCKET_PORT 仅宿主机发布用）
SIM_AGV_WS_URL=ws://agv-bridge:9090
# Lightning 原生地图传输。启用时同时填写 URL 与配对仿真端的 token。
NATIVE_MAP_BASE_URL=
NATIVE_MAP_TOKEN=
# docker 机器人 AGV_ID=AGV002（WSL 原生那套是 AGV001），TF child frame 必须一致
SIM_AGV_TF_CHILD_FRAME=AGV002/base_link
# RMS 身份：与 IDEA 实例（默认固定种子 SN）区分开，避免互相顶号
RMS_ROBOT_SN=jy-devlopment-202610270956-xuangu
RMS_ROBOT_NAME=JY玄骨上人

# 容器内的 Zenoh 配置文件路径
RMS_ZENOH_CONFIG_FILE=/app/config/zenoh.json5

# 容器内的质检图片目录
RMS_INSPECTION_IMAGE_DIR=/app/inspection-images
NATIVE_MAP_TOKEN=zioneer.com
NATIVE_MAP_BASE_URL=http://agv-bridge:8091